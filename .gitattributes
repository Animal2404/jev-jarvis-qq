# Shell scripts must keep LF endings: a CRLF gradlew fails on Linux CI with
# "bad interpreter: No such file or directory".
gradlew text eol=lf
gradlew.bat text eol=crlf
*.sh text eol=lf

# Keep the build reproducible across Windows checkouts and Linux CI.
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.apk binary
