<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      DayNight: the app follows the SYSTEM light/dark setting with no in-app
      switch. The `-night` resource qualifiers supply dark values.

      Theme.MaterialComponents.DayNight already handles widgets (dialogs, the
      EditText cursor/selection, ripples). What it could NOT fix is this app's
      own screens: every view is built in Kotlin and used hardcoded colours.
      Those now come from Palette.kt, which resolves the same night flag.

      windowBackground is set so the window itself does not flash white while
      content is being built in dark mode.
    -->
    <style name="Theme.JevProbe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorPrimary">@color/accent</item>
        <!-- Dialogs (model picker, clear-confirmation) follow the palette. -->
        <item name="alertDialogTheme">@style/Theme.JevProbe.Dialog</item>
    </style>

    <style name="Theme.JevProbe.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorPrimary">@color/accent</item>
    </style>

</resources>
